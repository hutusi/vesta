---
import BaseLayout from "@/layouts/BaseLayout.astro";
import FormEmbed from "@/components/FormEmbed.astro";
import { forms } from "@/config";
import { getEntry, render } from "astro:content";

const entry = await getEntry("pages", "donate");
if (!entry) throw new Error("Missing donate page");
const { Content } = await render(entry);
---

<BaseLayout
  title={entry.data.title}
  description={entry.data.description}
  locale="zh"
  narrow
>
  <article>
    <header class="border-paper-3 mb-10 border-b pb-6">
      <h1 class="font-display text-ink text-4xl">{entry.data.title}</h1>
    </header>
    <div class="prose">
      <Content />
    </div>
    <div class="mt-6">
      <FormEmbed
        url={forms.donate}
        title="赠书登记表"
        emailSubject="赠书给只买书图书馆"
      />
    </div>
  </article>
</BaseLayout>
