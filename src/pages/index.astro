---
import BaseLayout from "@/layouts/BaseLayout.astro";
---

<BaseLayout>
  <section class="mx-auto max-w-readable py-10">
    <p class="text-brick font-serif text-sm tracking-widest">乡村图书馆</p>
    <h1 class="font-display text-ink mt-3 text-5xl">只买书</h1>
    <p class="text-ink-soft mt-6 text-lg leading-relaxed">
      一座藏在老屋里的图书馆，自由取阅，凭良心借还。网站正在筹建中。
    </p>
  </section>
</BaseLayout>
