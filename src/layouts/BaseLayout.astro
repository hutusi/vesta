---
import "@/styles/global.css";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import { type Locale, defaultLocale, useTranslations } from "@/i18n/ui";

interface Props {
  title?: string;
  description?: string;
  locale?: Locale;
  /** URL of this same page in the other language, if a counterpart exists. */
  altUrl?: string;
  /** Constrain the main column to the readable measure (long-form pages). */
  narrow?: boolean;
}

const {
  title,
  description = "只买书是一座乡村图书馆，藏在老屋里，自由取阅，凭良心借还。",
  altUrl,
  narrow = false,
} = Astro.props;

const locale: Locale =
  Astro.props.locale ?? ((Astro.currentLocale as Locale) || defaultLocale);
const t = useTranslations(locale);

const siteName = t("site.name");
const fullTitle = title ? `${title}｜${siteName}` : `${siteName} · ${t("site.tagline")}`;
const htmlLang = locale === "en" ? "en" : "zh-Hans";

const canonical = new URL(Astro.url.pathname, Astro.site);
const ogLocale = locale === "en" ? "en_US" : "zh_CN";
---

<!doctype html>
<html lang={htmlLang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="canonical" href={canonical} />
    <meta name="theme-color" content="#f8f3ea" />
    <meta name="generator" content={Astro.generator} />

    <title>{fullTitle}</title>
    <meta name="description" content={description} />

    {/* hreflang alternates when a translated counterpart exists */}
    {
      altUrl && (
        <>
          <link
            rel="alternate"
            hreflang={locale === "en" ? "zh-Hans" : "en"}
            href={new URL(altUrl, Astro.site)}
          />
          <link rel="alternate" hreflang="x-default" href={canonical} />
        </>
      )
    }

    <meta property="og:type" content="website" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:locale" content={ogLocale} />
  </head>
  <body class="flex min-h-screen flex-col">
    <a
      href="#main"
      class="bg-brick sr-only rounded px-4 py-2 text-white focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-50"
    >
      {t("skip.content")}
    </a>

    <Header locale={locale} altUrl={altUrl} />

    <main
      id="main"
      class:list={[
        "mx-auto w-full flex-1 px-5 py-10",
        narrow ? "max-w-readable" : "max-w-6xl",
      ]}
    >
      <slot />
    </main>

    <Footer locale={locale} />
  </body>
</html>
