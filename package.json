{
  "name": "vesta",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "description": "只买书 (Zhimaishu) — a nonprofit rural library portal and catalog. 'Vesta' is the internal codename only.",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check && tsc --noEmit -p scripts/tsconfig.json",
    "astro": "astro",
    "ingest": "bun run scripts/ingest.ts",
    "covers": "bun run scripts/covers.ts"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "7.2.1",
    "@astrojs/sitemap": "3.7.3",
    "astro": "7.0.6",
    "pinyin-pro": "3.28.1"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.9",
    "@tailwindcss/vite": "4.3.2",
    "@types/bun": "1.3.14",
    "sharp": "0.35.3",
    "tailwindcss": "4.3.2",
    "typescript": "6.0.3"
  }
}
